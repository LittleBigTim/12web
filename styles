* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #333;
    background: #fafafa;
    line-height: 1.6;
}

header {
    background: #111;
    color: white;
    position: sticky;
    top: 0;
}

nav {
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    padding: 1rem 2rem;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
}

nav a {
    color: white;
    text-decoration: none;
}

.hero {
    height: 90vh;
    background: linear-gradient(
        rgba(0,0,0,0.4),
        rgba(0,0,0,0.4)
    ),
    url('images/hero.jpg') center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.hero-content {
    color: white;
}

.hero h2 {
    font-size: 4rem;
}

.hero p {
    margin: 20px 0;
    font-size: 1.2rem;
}

.btn {
    background: #ff6b35;
    color: white;
    padding: 12px 24px;
    border-radius: 5px;
    text-decoration: none;
}

.about,
.gallery,
.contact {
    max-width: 1200px;
    margin: auto;
    padding: 80px 20px;
}

.about h2,
.gallery h2,
.contact h2 {
    text-align: center;
    margin-bottom: 30px;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.art-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    transition: transform 0.3s;
}

.art-card:hover {
    transform: translateY(-5px);
}

.art-card img {
    width: 100%;
    height: 300px;
    object-fit: cover;
}

.art-card h3 {
    padding: 15px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 600px;
    margin: auto;
}

input,
textarea {
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 5px;
}

textarea {
    min-height: 150px;
}

button {
    background: #111;
    color: white;
    border: none;
    padding: 14px;
    cursor: pointer;
    border-radius: 5px;
}

button:hover {
    background: #333;
}

footer {
    background: #111;
    color: white;
    text-align: center;
    padding: 20px;
}
